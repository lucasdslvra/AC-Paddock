# Discord Developer Portal → OAuth2 → General
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# ID du serveur Discord du groupe (mode développeur Discord → clic droit sur le serveur → Copier l'ID)
DISCORD_GUILD_ID=

# US-L1/L2 — webhook du salon d'annonces (nouvelle soirée, nouveau mod) du serveur
# ci-dessus, et de lui seul : les serveurs ouverts depuis l'espace admin ont chacun le
# leur, renseigné là-bas. Discord → salon → Intégrations → Webhooks → Copier l'URL.
# Facultatif : sans lui, ce serveur-là n'est prévenu de rien et l'espace admin le dit.
# C'est un secret : qui l'a peut écrire dans le salon.
DISCORD_WEBHOOK_URL=

# Base Postgres Supabase (Project Settings → Database → Connection string)
# Attention : les crochets de [YOUR-PASSWORD] ne font pas partie du mot de passe, et il
# faut percent-encoder ses caractères spéciaux ($ → %24, @ → %40…) — Next.js fait de
# l'expansion de variables en lisant ce fichier et tronquerait un mot de passe avec un $.
# App : transaction pooler, port 6543 (adapté au serverless)
DATABASE_URL=
# CLI Prisma (migrations) : session pooler, port 5432
DIRECT_URL=

# Supabase Storage — images d'aperçu des mods (bucket public « mod-images »)
# URL du projet : Project Settings → Data API → Project URL
SUPABASE_URL=
# Clé secrète : Project Settings → API Keys → Secret keys (sb_secret_…).
# Ne sort jamais du serveur. Ne pas confondre avec la clé publiable.
SUPABASE_SECRET_KEY=

# Secret du cron de maintenance (balayage des images orphelines).
# Génère-le avec : openssl rand -base64 32
CRON_SECRET=
