// Schéma Prisma — voir le cahier des charges §4 « Modèle de données ».
// Périmètre actuel : US-A5 (User), US-B1 (Mod), US-C1 (Tag/ModTag), US-F1 (Vote),
// US-G1/G2 (Soiree/SoireeMod) et US-K2/K3 (DeletionLog, AppConfig).
//
// Le cahier §4 appelle la soirée `Session`. Le modèle s'appelle ici `Soiree` : `Session`
// est déjà le type de next-auth, présent dans presque toutes les routes sous la forme
// `const session = await auth()`, et `prisma.session` juste à côté se lirait comme
// l'une ou l'autre chose. C'est le mot de l'interface, et celui du cahier §2.5.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

/// Vocabulaire du cahier des charges §4 : type (car/track).
/// L'interface parle de « véhicule » / « circuit » — la conversion est faite
/// à la frontière de l'API, dans lib/mods/type.ts.
enum ModType {
  CAR
  TRACK
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatarUrl String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  /// Le serveur Discord où l'appartenance de ce membre a été vérifiée, à sa dernière
  /// connexion (cahier §2.1 : l'accès est réservé aux membres du serveur). Le nom est
  /// recopié à côté de l'identifiant parce qu'il ne se relit pas sans jeton : Discord
  /// ne donne la liste des serveurs qu'au membre lui-même, au moment où il se connecte.
  ///
  /// Nul pour les lignes créées par une écriture (`upsertSessionUser`) sans connexion
  /// depuis cette colonne : on préfère l'aveu au serveur courant recopié d'office, qui
  /// affirmerait une vérification qui n'a pas eu lieu.
  guildId   String?
  guildName String?

  /// La dernière connexion vérifiée — la date de ce que dit `guildName`. « Membre de X »
  /// sans le moment où ça a été constaté ne vaut rien : quelqu'un a pu quitter le
  /// serveur depuis, l'application ne le revoit qu'à sa prochaine connexion.
  lastSeenAt DateTime?

  mods  Mod[]
  votes Vote[]

  /// Soirées créées par ce membre (US-G1, réservé aux admins) et mods qu'il a engagés
  /// dans une soirée (US-G2).
  soirees     Soiree[]
  engagedMods SoireeMod[]

  /// Liens secondaires ajoutés sur les fiches des autres (usage wiki, cahier §2.2).
  modLinks ModLink[]

  /// Ce que ce membre a corrigé ou complété sur les fiches (cahier §2.2).
  contributions ModContribution[]

  /// US-K2/K3 — ce que ce membre a supprimé, et les réglages qu'il a modifiés.
  deletions     DeletionLog[]
  configUpdates AppConfig[]

  /// Les serveurs Discord qu'il a ouverts à l'accès depuis l'espace admin.
  authorizedGuilds AuthorizedGuild[]
}

model Mod {
  id          String  @id @default(cuid())
  type        ModType
  name        String
  /// Lien externe (RaceDepartment, Drive…) — champ principal du cahier §2.2.
  url         String
  /// Forme normalisée de `url` (`modUrlKey`, lib/mods/url.ts) : c'est la colonne que
  /// compare GET /api/mods/check-url (US-D2). Recalculée à chaque écriture de `url`.
  /// Volontairement sans `@unique` : le cahier §2.4 veut un avertissement, pas un
  /// blocage — « Créer quand même » doit rester possible.
  urlKey      String
  description String?
  imageUrl    String?

  /// Fichier uploadé (Epic H) : encore vide tant que US-H1 n'est pas faite,
  /// mais présent dès maintenant pour coller au modèle du cahier §4.
  fileUrl        String?
  fileUploadedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tags    ModTag[]
  votes   Vote[]
  /// Liens secondaires ajoutés par les membres (miroir, pack de textures, patch…).
  /// Le lien du cahier §2.2 reste `url` : c'est lui que porte le bouton de
  /// téléchargement et lui seul qui sert la détection de doublons (`urlKey`).
  links   ModLink[]
  /// Engagements de cette fiche dans des soirées (US-G2).
  soirees SoireeMod[]
  /// Ce que les membres y ont corrigé depuis sa création (cahier §2.2).
  contributions ModContribution[]

  createdAt DateTime @default(now())
  /// Usage wiki : n'importe quel membre peut éditer la fiche (US-B3).
  updatedAt DateTime @updatedAt
  /// US-D1 — recherche floue sur le nom, via un index GIN trigram (pg_trgm). Prisma ne
  /// sait pas décrire cet index : il est créé à la main dans la migration
  /// `20260829200000_duplicate_detection`, et `prisma migrate diff` ne le voit pas.

  @@index([authorId])
  @@index([createdAt])
  @@index([urlKey])
}

/// Vocabulaire libre, alimenté par les membres (cahier §2.2). Les noms sont normalisés
/// avant d'arriver ici — minuscules, sans accent, mots liés par des tirets
/// (lib/mods/tags.ts) : c'est ce qui fait que `Drift` et `drift` sont le même tag, et
/// ce que `@unique` fait respecter.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  mods ModTag[]
}

/// Table d'association mod ↔ tag. Les deux `onDelete: Cascade` sont ce sur quoi
/// comptent DELETE /api/mods/[id] (US-B4) et la suppression d'un tag : effacer une
/// fiche ou un tag ne doit jamais laisser d'association orpheline.
/// Un lien secondaire d'une fiche. Table à part plutôt qu'un tableau de textes sur
/// `Mod` : un lien porte un intitulé et un auteur, et se retire à l'unité — trois
/// choses qu'une colonne `text[]` ne saurait pas dire.
model ModLink {
  id String @id @default(cuid())

  modId String
  mod   Mod    @relation(fields: [modId], references: [id], onDelete: Cascade)

  /// Intitulé libre (« miroir », « pack de textures »). Vide, la fiche affiche le
  /// domaine du lien — un intitulé n'apprend rien de plus que « racedepartment.com ».
  label String?
  url   String

  /// Le membre qui l'a ajouté. Conservé même s'il n'est pas l'auteur de la fiche :
  /// c'est ce que la fiche affiche sous le lien.
  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id])

  createdAt DateTime @default(now())

  /// Les liens d'une fiche se lisent toujours ensemble, dans leur ordre d'ajout.
  @@index([modId])
  @@index([addedById])
}

/// Cahier §2.2 — le fil des corrections d'une fiche, tenu par l'usage wiki : « n'importe
/// quel membre peut compléter ou corriger la fiche d'un mod existant ».
///
/// La fiche ne garde d'un membre que ce qu'il a laissé (`authorId`, `ModLink.addedById`) :
/// une description remplacée, un tag retiré, une image changée ne se voient nulle part,
/// et `updatedAt` ne dit ni qui ni quoi. C'est cette table qui répond, sur la fiche, à
/// « qui a touché à ça, et quand ? » — la seule question que pose un wiki à plusieurs
/// mains.
///
/// La création n'y est **pas** écrite : `Mod.authorId` et `Mod.createdAt` la disent déjà,
/// pour toutes les fiches, y compris celles d'avant cette table. La fiche la reconstitue
/// à la lecture (lib/mods/contributions.ts) plutôt que de la dupliquer ici.
model ModContribution {
  id String @id @default(cuid())

  modId String
  mod   Mod    @relation(fields: [modId], references: [id], onDelete: Cascade)

  kind ContributionKind
  /// Ce sur quoi portait le geste, quand le genre ne suffit pas à le dire : le nom du
  /// tag ajouté, l'intitulé du lien retiré, l'ancien nom de la fiche. Le libellé complet
  /// est composé à l'affichage — le stocker figerait la formulation en base.
  detail String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  /// Le fil se lit toujours par fiche, du plus récent au plus ancien.
  @@index([modId, createdAt])
  @@index([authorId])
}

/// Les gestes qu'une fiche enregistre. Un genre par phrase affichable : ajouter une
/// description et la remplacer ne se racontent pas pareil, et la distinction est perdue
/// si les deux s'écrivent `DESCRIPTION`.
enum ContributionKind {
  NAME
  TYPE
  URL
  DESCRIPTION_ADDED
  DESCRIPTION_UPDATED
  DESCRIPTION_REMOVED
  IMAGE_ADDED
  IMAGE_UPDATED
  IMAGE_REMOVED
  TAG_ADDED
  TAG_REMOVED
  LINK_ADDED
  LINK_REMOVED
}

model ModTag {
  modId String
  tagId String

  mod Mod @relation(fields: [modId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modId, tagId])
  /// Le filtrage du catalogue part du tag (US-C2) : sans cet index, la jointure
  /// scanne toute la table — la clé primaire ne sert que dans l'autre sens.
  @@index([tagId])
}

/// US-F1 / US-G3 — un vote d'un membre pour un mod, dans le cadre d'une soirée.
///
/// Le cahier §4 rattache le vote à un `SessionMod`, et c'est la règle depuis US-G3 :
/// seuls les mods engagés dans la soirée en cours sont votables, et le même vote
/// s'écrit qu'on clique depuis le catalogue, depuis la fiche ou depuis la soirée.
///
/// `soireeModId` reste pourtant nullable, pour une seule raison : les votes écrits par
/// le MVP (« vote basique sans notion formelle de soirée », cahier §6) n'ont aucune
/// soirée à quoi se rattacher. Les rendre obligatoires les aurait effacés. Ils restent
/// donc en base avec `soireeModId` à NULL, comptent toujours dans le total d'une fiche,
/// et plus rien n'en crée : toute écriture passe désormais par une soirée.
model Vote {
  id          String   @id @default(cuid())
  userId      String
  /// Redondant avec `soireeMod.modId` pour les votes de soirée, et c'est voulu : le
  /// catalogue trie sur `_count` des votes d'une fiche (US-E4) et compte sa popularité
  /// toutes soirées confondues. Sans cette colonne, chaque comptage passerait par une
  /// jointure — et les votes hérités du MVP n'auraient plus de mod du tout.
  modId       String
  /// NULL = vote hérité du MVP, antérieur à l'Epic G. Renseigné pour tout vote récent.
  soireeModId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `Cascade` comme pour `ModTag` (US-C1) : DELETE /api/mods/[id] (US-B4) compte
  /// dessus pour ne pas laisser de votes orphelins derrière une fiche supprimée.
  mod       Mod        @relation(fields: [modId], references: [id], onDelete: Cascade)
  /// Désengager un mod d'une soirée emporte les votes qu'il y avait reçus : ils ne
  /// veulent plus rien dire une fois l'association défaite.
  soireeMod SoireeMod? @relation(fields: [soireeModId], references: [id], onDelete: Cascade)

  /// US-G3 — un membre, un vote par mod engagé, par soirée. Un même mod reproposé à
  /// une soirée suivante est donc revotable, ce que `@@unique([userId, modId])` (la
  /// contrainte du MVP, retirée par la migration `20260830180000_soirees`) interdisait.
  ///
  /// Postgres considère deux NULL comme distincts : cette contrainte ne dit donc rien
  /// des votes hérités. C'est un index unique partiel, posé à la main dans la même
  /// migration, qui garde leur unicité — Prisma ne sait pas le décrire.
  @@unique([userId, soireeModId])
  /// Le comptage part du mod (US-F2), l'unicité ne sert que dans l'autre sens.
  @@index([modId])
}

/// US-G1 — une soirée (cahier §2.5 : « date + éventuellement thème »).
///
/// Il n'y a pas de colonne « en cours » : l'état se déduit de la date, et une colonne
/// à maintenir se serait désynchronisée dès la première soirée passée sans que
/// personne ne la bascule. La soirée en cours est la prochaine à venir — voir
/// `currentSoiree` (lib/soirees/current.ts), qui fait foi.
model Soiree {
  id   String   @id @default(cuid())
  /// Le thème, tel que l'interface l'appelle (« touge only », « rallye »…). Facultatif :
  /// le cahier ne rend obligatoire que la date.
  name String?
  date DateTime

  /// Le serveur Discord dont c'est la soirée. Une soirée se joue avec un groupe, et
  /// depuis que plusieurs serveurs peuvent se connecter (`AuthorizedGuild`), « la
  /// soirée en cours » n'a de sens que rapportée à l'un d'eux : sans cette colonne,
  /// deux groupes voteraient dans le même classement sans jamais se croiser en jeu.
  ///
  /// Pas de clé étrangère vers `AuthorizedGuild` : le serveur du déploiement n'y a pas
  /// de ligne (voir ce modèle), et une soirée doit survivre au retrait de son serveur
  /// de la liste — l'archive raconte ce qui a été joué, pas qui a encore l'accès.
  guildId String

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  mods SoireeMod[]

  createdAt DateTime @default(now())

  /// Toutes les lectures partent du serveur puis remontent les dates : la soirée en
  /// cours (`currentSoiree`), l'historique (Epic I), la liste de l'espace admin.
  @@index([guildId, date])
  @@index([createdById])
}

/// US-G2 — un mod du catalogue engagé dans une soirée. C'est cette ligne, et non le mod,
/// que les votes de la soirée désignent.
model SoireeMod {
  id       String @id @default(cuid())
  soireeId String
  modId    String

  /// Le membre qui a engagé ce mod — la soirée affiche « engagé par … ». N'importe quel
  /// membre le peut (cahier §2.5), pas seulement l'auteur de la fiche ni un admin.
  engagedById String

  soiree    Soiree @relation(fields: [soireeId], references: [id], onDelete: Cascade)
  /// `Cascade` comme partout ailleurs : DELETE /api/mods/[id] (US-B4) compte dessus
  /// pour ne pas laisser d'engagement derrière une fiche supprimée — c'est ce
  /// qu'annonçait l'en-tête de ce fichier avant l'Epic G.
  mod       Mod    @relation(fields: [modId], references: [id], onDelete: Cascade)
  engagedBy User   @relation(fields: [engagedById], references: [id])

  votes Vote[]

  createdAt DateTime @default(now())

  /// US-G2 — un mod ne peut être engagé qu'une fois dans une même soirée.
  @@unique([soireeId, modId])
  /// Le classement part de la soirée (US-G4) ; l'unicité sert dans ce sens-là aussi,
  /// mais la fiche a besoin de l'autre pour savoir où elle est engagée.
  @@index([modId])
  @@index([engagedById])
}

/// Les serveurs Discord qui donnent accès à l'application, en plus de celui de la
/// configuration de déploiement (`DISCORD_GUILD_ID`).
///
/// Le serveur d'origine reste dans l'environnement et n'a pas de ligne ici : c'est lui
/// qui rend impossible de se verrouiller dehors depuis l'espace admin — quoi qu'on
/// retire de cette table, il autorise encore quelqu'un à entrer. Les serveurs ajoutés
/// ici s'ouvrent et se referment sans redéploiement, ce que la variable d'environnement
/// ne permet pas.
model AuthorizedGuild {
  id String @id @default(cuid())

  /// L'identifiant Discord du serveur (snowflake). Unique : deux lignes pour le même
  /// serveur ne voudraient rien dire de plus qu'une seule.
  guildId String @unique

  /// Le nom affiché. Facultatif : Discord ne le publie qu'aux membres du serveur ou via
  /// le widget public, souvent désactivé. À défaut, l'écran retombe sur le nom qu'une
  /// connexion a rapporté (`User.guildName`), puis sur l'identifiant.
  name String?

  /// US-K1 — protège de la suppression. Retirer un serveur déconnecte tout un groupe à
  /// sa prochaine connexion : le verrou est là pour que ça ne se fasse pas d'un clic
  /// distrait, et il se lève depuis le même écran.
  locked Boolean @default(false)

  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id])

  createdAt DateTime @default(now())

  @@index([addedById])
}

/// US-K2 — le journal des suppressions (cahier §2.6 : l'admin « modère, suppression de
/// n'importe quel contenu »).
///
/// Une suppression est irréversible et ne laisse rien derrière elle : sans cette table,
/// « qui a effacé la fiche qu'on cherche ? » n'aurait aucune réponse. Le backlog parle
/// de « logs applicatifs », mais des lignes de log serveur ne sont lisibles que depuis
/// la console de l'hébergeur — le journal doit s'afficher dans l'espace admin.
model DeletionLog {
  id String @id @default(cuid())

  target   DeletionTarget
  /// L'identifiant de la ligne effacée. Il ne pointe plus sur rien — aucune clé
  /// étrangère, donc — mais c'est ce qui rattache l'entrée à un lien mort partagé
  /// ailleurs (« /mods/xyz renvoie 404 » : le journal dit pourquoi).
  targetId String
  /// Le nom de ce qui a disparu, recopié au moment de la suppression : la ligne
  /// effacée ne peut plus le donner.
  label    String
  /// Ce que la suppression a emporté — « 12 votes », « 3 fiches ». Facultatif : toutes
  /// les suppressions ne détruisent pas de contenu autour d'elles.
  detail   String?

  /// Vrai quand l'auteur agissait au titre de son rôle admin, faux quand il supprimait
  /// sa propre fiche (US-B4, ouvert à l'auteur). Les deux sont journalisées — un
  /// journal qui ne montrerait que la moitié des suppressions n'expliquerait pas
  /// l'autre — mais seule la première est la modération dont parle US-K2.
  asAdmin Boolean

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  /// Le journal se lit du plus récent au plus ancien, et ne se lit que comme ça.
  @@index([createdAt])
  @@index([actorId])
}

enum DeletionTarget {
  MOD
  TAG
  SOIREE
}

/// US-K3 — les réglages modifiables depuis l'espace admin (cahier §2.6 : l'admin
/// « gère la config (ex. taille max des uploads) »).
///
/// Une table clé/valeur plutôt qu'une colonne par réglage : le backlog demande
/// « table/clé de configuration », et un réglage de plus ne doit pas coûter une
/// migration. La valeur est stockée en texte pour la même raison — c'est
/// `lib/admin/settings.ts` qui sait comment lire chaque clé, et qui borne ce qui entre.
///
/// Un réglage absent n'est pas une erreur : chaque clé a une valeur par défaut dans le
/// code, et la table ne contient que ce que quelqu'un a réellement changé.
model AppConfig {
  key   String @id
  value String

  /// Qui a posé cette valeur, et quand. Le formulaire l'affiche : un plafond d'upload
  /// qui a bougé sans que personne ne s'en souvienne est la première question qu'on se
  /// pose quand un envoi est refusé.
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}
